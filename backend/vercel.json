{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "node scripts/prepare-vercel-output.js",
  "outputDirectory": "public",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/", "destination": "/api" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60
    }
  }
}
